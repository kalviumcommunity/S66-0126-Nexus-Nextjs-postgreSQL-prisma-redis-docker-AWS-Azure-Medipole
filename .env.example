# Example environment variables for this project
# Copy this file to .env.local and fill in real values for local development

# Server-side only (never exposed to client)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb  # Database connection string (server only)
SECRET_API_KEY=your_secret_api_key_here  # Secret API key for backend services (server only)

# Client-side (safe to expose, must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=https://api.example.com  # Base URL for public API requests (client & server)
